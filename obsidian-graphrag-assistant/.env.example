# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=notes_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# Groq API (LLM generation)
GROQ_API_KEY=your_groq_api_key
GROQ_LLM_MODEL=groq/compound-mini

# Embeddings — local fastembed (no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
VECTOR_INDEX_NAME=chunk_embedding_index
TOP_K=5
GRAPH_HOPS=2

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Application
PROJECT_TAG=obsidian-graphrag-assistant
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:8000
FRONTEND_ORIGINS=
LOG_LEVEL=INFO
MAX_MARKDOWN_FILE_SIZE_MB=10

# Lightweight in-process rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=120
RATE_LIMIT_REGISTER_PER_HOUR=60
RATE_LIMIT_EXPENSIVE_PER_MINUTE=60
